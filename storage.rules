rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function maxImageSize() { return 5 * 1024 * 1024; } // 5 MB
    // Older app builds uploaded images without a contentType, so also accept
    // a missing/generic type when the file name has an image extension.
    function hasImageExtension() {
      return request.resource.name.lower().matches('.*[.](jpg|jpeg|png|webp|gif|heic|heif)$');
    }
    function isUntyped() {
      return request.resource.contentType == null ||
             request.resource.contentType == '' ||
             request.resource.contentType == 'application/octet-stream';
    }
    function isImage() {
      return (request.resource.contentType != null &&
              request.resource.contentType.matches('image/.*')) ||
             (isUntyped() && hasImageExtension());
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/users/$(uid())).data.role == 'admin';
    }

    function isClubAdmin(clubId) {
      return isSignedIn() &&
        firestore.get(/databases/(default)/documents/clubs/$(clubId)).data.adminUid == uid();
    }

    function isClubStaff(clubId) {
      return isSignedIn() && (
        isClubAdmin(clubId) ||
        firestore.get(/databases/(default)/documents/users/$(uid())).data.get('clubId', '') == clubId ||
        (uid() in firestore.get(/databases/(default)/documents/clubs/$(clubId)).data.get('staffUids', []))
      );
    }

    function isVideoOrImage() {
      return isImage() ||
             (request.resource.contentType != null &&
              request.resource.contentType.matches('video/.*'));
    }

    // ── Club gallery (photos + videos, up to 100 MB) ────────────────────────
    match /clubs/{clubId}/gallery/{allPaths=**} {
      allow read: if true;
      allow write: if (isClubStaff(clubId) || isAdmin())
        && isVideoOrImage()
        && request.resource.size < 100 * 1024 * 1024;
      allow delete: if isClubStaff(clubId) || isAdmin();
    }

    // ── Club logos / covers / player photos / stadium photos ───────────────
    // Write restricted to club staff or admin only.
    match /clubs/{clubId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isClubStaff(clubId) || isAdmin())
        && isImage()
        && request.resource.size < maxImageSize();
      allow delete: if isClubStaff(clubId) || isAdmin();
    }

    // ── User photos ─────────────────────────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn()
        && uid() == userId
        && isImage()
        && request.resource.size < maxImageSize();
      allow delete: if isSignedIn() && uid() == userId;
    }

    // ── Game assets (puzzle images, prize photos) ───────────────────────────
    // Write: admin only. Read: public (fans need to see prize photos & puzzles).
    match /games/{gameId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && request.resource.size < maxImageSize();
      allow delete: if isAdmin();
    }
    match /prizes/{prizeId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isImage() && request.resource.size < maxImageSize();
      allow delete: if isSignedIn();
    }

    // ── Sponsor PDFs (max 10 MB, signed-in users) ───────────────────────────
    match /sponsors/{sponsorId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf' ||
          isImage()
        );
      allow delete: if isSignedIn();
    }
  }
}
